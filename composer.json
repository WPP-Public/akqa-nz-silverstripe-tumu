{
    "name": "akqa/silverstripe-tumu",
    "type": "silverstripe-vendormodule",
    "description": "Foundation for SilverStripe projects at AKQA",
    "license": "MIT",
    "bin": [
        "bin/tag_release"
    ],
    "require": {
        "silverstripe/framework": "^5.4",
        "silverstripe/cms": "^5.4",
        "silverstripe/errorpage": "^2",
        "silverstripe/userforms": "^6",
        "dnadesign/silverstripe-elemental": "^5",
        "heyday/silverstripe-menumanager": "^4",
        "larapack/dd": "^1.1",
        "silverstripe/taxonomy": "^3",
        "silverstripe/tagfield": "^3",
        "silverstripe/environmentcheck": "^3",
        "silverstripe/login-forms": "^5",
        "symbiote/silverstripe-queuedjobs": "^5",
        "jonom/silverstripe-betternavigator": "^6",
        "wilr/silverstripe-googlesitemaps": "^3",
        "wilr/silverstripe-togglegroup-field": "*",
        "unclecheese/display-logic": "^3",
        "silverstripe/redirectedurls": "^3",
        "silverstripe/sharedraftcontent": "^3",
        "silverstripe/totp-authenticator": "^5",
        "jonom/focuspoint": "^5",
        "silverstripe/linkfield": "^4",
        "silverstripe/mfa": "^5",
        "silverstripe/spamprotection": "^4",
        "nesbot/carbon": "^3.11",
        "kinglozzer/metatitle": "^3",
        "silverstripe/iframe": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "cambis/silverstan": "^1",
        "silverstripe/behat-extension": "^5"
    },
    "extra": {
        "branch-alias": {
            "dev-5": "5.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Akqa\\SilverStripe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akqa\\SilverStripe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "analyse:fix": "phpstan analyse --fix",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
